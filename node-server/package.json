{
    "version": "1.0.0",
    "description": "Sprint planning poker in-memory WebSocket server",
    "license": "BSD-3-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/discorev/sprint-planning-poker.git",
        "directory": "node-server"
    },
    "dependencies": {
        "redis": "^4.2.0",
        "ws": "^8.8.1"
    },
    "scripts": {
        "dev": "nodemon",
        "start": "node index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "tsc",
        "get-version": "echo $npm_package_version"
    },
    "devDependencies": {
        "@types/ws": "^8.5.3",
        "@vitest/coverage-v8": "^3.2.4",
        "codecov": "^3.8.3",
        "nodemon": "^2.0.19",
        "ts-node": "^10.9.1",
        "typescript": "^4.7.4",
        "vitest": "^3.2.4"
    },
    "nyc": {
        "exclude": "**/*.spec.*",
        "reporter": [
            "lcovonly",
            "html",
            "text-summary"
        ]
    }
}
